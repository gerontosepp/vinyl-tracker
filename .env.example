# PostgreSQL Database Configuration
POSTGRES_DB=vinyl_tracker
POSTGRES_USER=vinyl_user
POSTGRES_PASSWORD=vinyl_password

# Vinyl Tracker Encryption Keys
# IMPORTANT: Change these for production!
VINYL_ENCRYPTION_PASSWORD=changeit-for-production-use-23948239048
VINYL_ENCRYPTION_SALT=5c074494c45680a7

# JWT Token Secret
# REQUIRED: application startup fails if missing or shorter than 32 characters.
# MUST be a strong > 32 character key (e.g. from `openssl rand -base64 32`)
JWT_SECRET=superSecretDevelopmentKeyDoNotUseInProduction123!

# CORS Configuration
# Comma-separated list of allowed frontend origins (no wildcard)
CORS_ALLOWED_ORIGINS=https://localhost:5173,https://127.0.0.1:5173
# Keep false unless cookie-based auth is required
CORS_ALLOW_CREDENTIALS=false

# Image Proxy SSRF Protection
# Comma-separated allowlist of target hosts for /api/proxy/image
IMAGE_PROXY_ALLOWED_HOSTS=i.discogs.com,s.discogs.com,api.discogs.com

# HttpOnly Auth Cookie Configuration
AUTH_COOKIE_NAME=vinyl_token
AUTH_COOKIE_MAX_AGE_SECONDS=86400
# Keep true in production (HTTPS required)
AUTH_COOKIE_SECURE=true
# Allowed: Lax, Strict, None
AUTH_COOKIE_SAME_SITE=Lax
